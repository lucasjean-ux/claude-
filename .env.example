# Copier en .env puis renseigner. Sans clé, render.py utilise episodes/<episode>/voix.mp3.
ELEVENLABS_API_KEY=
# Voix française posée (ID visible dans la Voice Library ElevenLabs)
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.6
ELEVENLABS_STYLE=0.15
# 0.7 à 1.2 — ajuster pour viser 80–90 s
ELEVENLABS_SPEED=1.0
